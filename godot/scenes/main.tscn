[node name="Main" type="Node3D"]
script = ExtResource("1_main")

[node name="XROrigin3D" type="XROrigin3D" parent="."]
script = ExtResource("3_player")

[node name="XRCamera3D" type="XRCamera3D" parent="XROrigin3D"]
; 1.65m is only the flat-mode fallback. In a real session the runtime
; supplies head height and overwrites this every frame.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.65, 0)

[node name="LeftHand" type="XRController3D" parent="XROrigin3D"]
tracker = &"left_hand"

[node name="RightHand" type="XRController3D" parent="XROrigin3D"]
tracker = &"right_hand"

[node name="City" type="Node3D" parent="."]
script = ExtResource("2_city")

; The dojo sits 120m above the city, which stays drawn far below — the same
; arrangement as the WebXR build, so entering the fight is a move rather
; than a level load.
[node name="Dojo" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 120, 0)
script = ExtResource("4_sword")

; The circuit is laid on the street grid at ground level, so it shares the
; city's coordinates rather than sitting on its own transform.
[node name="Circuit" type="Node3D" parent="."]
script = ExtResource("5_racing")

[node name="Lounge" type="Node3D" parent="."]
script = ExtResource("6_lounge")
