[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/city.gd" id="2_city"]
[ext_resource type="Script" path="res://scripts/player.gd" id="3_player"]
[ext_resource type="Script" path="res://scripts/sword.gd" id="4_sword"]
[ext_resource type="Script" path="res://scripts/racing.gd" id="5_racing"]
